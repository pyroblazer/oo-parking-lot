# ============================================================================
# Rails Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values

# ============================================================================
# Application Configuration
# ============================================================================
RAILS_ENV=development
APP_VERSION=1.0.0
SECRET_KEY_BASE=your_secret_key_base_here_generate_with_rails_secret
APP_NAME=OO Parking Lot
PORT=8082

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oo_parking_lot
# Production: postgresql://user:password@host:5432/database?pool=25&timeout=5000

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
# Production: redis://:password@host:6379/0

# ============================================================================
# Kafka Configuration
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Production: kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092

# ============================================================================
# Observability Configuration
# ============================================================================

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# OpenTelemetry (Distributed Tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rails-backend
OTEL_SERVICE_VERSION=1.0.0

# Prometheus (Metrics)
PROMETHEUS_EXPORTER_PORT=9394

# Logging
LOG_LEVEL=info
RAILS_LOG_TO_STDOUT=true

# ============================================================================
# Security Configuration
# ============================================================================

# Content Security Policy
CSP_REPORT_URI=https://your-csp-report-endpoint.com/report

# Rate Limiting (Rack::Attack)
RACK_ATTACK_CACHE_STORE=redis
RACK_ATTACK_THROTTLE_ENABLED=true

# ============================================================================
# CORS Configuration
# ============================================================================
# Allowed origins for API access (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081

# ============================================================================
# Sidekiq Configuration
# ============================================================================
SIDEKIQ_CONCURRENCY=10
SIDEKIQ_QUEUES=default,kafka_events,billing,audit,analytics

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_CONTINUOUS_PARKING=true
ENABLE_BILLING_AUDIT=true
ENABLE_KAFKA_EVENTS=true

# ============================================================================
# Performance Configuration
# ============================================================================
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=1
RAILS_WORKER_TIMEOUT=60

# ============================================================================
# Email Configuration (optional)
# ============================================================================
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
EMAIL_FROM=noreply@oo-parking-lot.com

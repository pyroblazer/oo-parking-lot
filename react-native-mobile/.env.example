# =============================================================================
# OO Parking Lot — React Native Mobile App Configuration
# =============================================================================
#
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# After changing .env, restart Metro bundler with cache clear:
#   npx react-native start --reset-cache
#
# =============================================================================
# API SERVER
# =============================================================================
#
# The base URL of the backend API server (no trailing slash).
#
# Available backends:
#   Go   (Data Plane)     — default, port 8082
#   Rails (Control Plane) — port 3000
#
# --- Android Emulator ---
# With ADB reverse (recommended, run: npm run setup-ports):
#   API_BASE_URL=http://localhost:8082
#
# Without ADB reverse (use emulator alias):
#   API_BASE_URL=http://10.0.2.2:8082
#
# --- iOS Simulator ---
#   API_BASE_URL=http://localhost:8082
#
# --- Physical Device ---
# Use your computer's LAN IP (find it with: ifconfig or ipconfig):
#   API_BASE_URL=http://192.168.1.100:8082
#
# --- Docker / Remote ---
# Point to the host or remote server:
#   API_BASE_URL=http://your-server:8082
#
API_BASE_URL=http://localhost:8082

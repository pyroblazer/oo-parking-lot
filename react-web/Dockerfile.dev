# React Web Dev Dockerfile
# Development build with hot-reload support

FROM oven/bun:1 AS base

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code
COPY . .

EXPOSE 3002

CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0"]

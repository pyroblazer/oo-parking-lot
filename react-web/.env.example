# =============================================================================
# React Web Environment Variables
# =============================================================================
# This file contains all environment variables used by the React Web frontend.
# Copy this file to .env and update the values as needed for your environment.
#
# Note: Environment variables prefixed with VITE_ are exposed to the client-side
# code and can be accessed via import.meta.env.VITE_* in the application.
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# The base URL for the backend API server
# This is used by the frontend to make HTTP requests to the parking lot API
#
# Available Backends:
# - Go Backend (Data Plane): http://localhost:8082/api/v1
# - Ruby Backend (Control Plane): http://localhost:3000/api/v1
#
# Usage Examples:
#
# 1. Connecting to Go Backend (Data Plane):
#    - Development: http://localhost:8082/api/v1
#    - Docker: http://go-backend:8082/api/v1
#    - Production: https://api.example.com/api/v1
#
# 2. Connecting to Ruby Backend (Control Plane):
#    - Development: http://localhost:3000/api/v1
#    - Docker: http://rails-backend:3000/api/v1
#    - Production: https://api.example.com/api/v1
#
# Backend Selection Guide:
# - Use Go Backend for high-performance data operations and production workloads
# - Use Ruby Backend for management operations, testing, and development
# - Both backends provide the same API endpoints and are fully compatible
#
# Required Environment Variables for Ruby Backend Connection:
# - VITE_API_BASE_URL: Set to http://localhost:3000/api/v1 for local Ruby backend
# - Ensure Ruby backend is running on port 3000
# - Ensure CORS is configured to allow requests from your frontend URL
#
# Used in:
# - src/api.ts (line 25)
# - src/api/parkingApi.ts (line 249-250)
VITE_API_BASE_URL=http://localhost:8082/api/v1
